<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SmolkrPenGenderTargets - the BepInEx plugin itself.

    This is the only project that knows about Unity, BepInEx and ASKA. It reads
    each smolkr pen's animals out of the running game, asks
    SmolkrPenGenderTargets.Core which one should be slaughtered, and hands that
    answer to the villager through a Harmony patch.

    Targets net6.0 because that is the runtime BepInEx 6 (IL2CPP) hosts plugins
    on for this game.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SmolkrPenGenderTargets</AssemblyName>
    <RootNamespace>SmolkrPenGenderTargets</RootNamespace>

    <!-- Interop assemblies are huge and generate noise we cannot act on. -->
    <NoWarn>$(NoWarn);CS0649;CS0169;CS1591</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmolkrPenGenderTargets.Core\SmolkrPenGenderTargets.Core.csproj" />
  </ItemGroup>

  <!--
    BepInEx / Harmony / Il2CppInterop. Private=false everywhere: these already
    exist in the player's install and must not be copied into the plugin folder,
    or BepInEx would load two copies of the same assembly.
  -->
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExCoreDir)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(BepInExCoreDir)\BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExCoreDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(BepInExCoreDir)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    The game's own assemblies, as generated by Il2CppInterop from ASKA's IL2CPP
    binary. These are regenerated whenever the game updates, so the build must be
    re-run after a patch.
  -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(AskaInteropDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SandSailorStudio"><HintPath>$(AskaInteropDir)\SandSailorStudio.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(AskaInteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(AskaInteropDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(AskaInteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Fusion.Runtime"><HintPath>$(AskaInteropDir)\Fusion.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
